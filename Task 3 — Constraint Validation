def validate_constraints(data, min_count=1, keyword=None):
    if len(data) < min_count:
        return {
            "status": "fail",
            "reason": f"Less than {min_count} items"
        }
    
    if keyword:
        matches = [item for item in data if keyword.lower() in item.lower()]
        
        if not matches:
            return {
                "status": "fail",
                "reason": f"No items contain keyword '{keyword}'"
            }
        
        return {
            "status": "pass",
            "matches": matches
        }
    
    return {
        "status": "pass",
        "message": "Constraints satisfied"
    }


# 🔍 Test
issues = ["Bug in login", "Crash on load", "UI issue"]

print(validate_constraints(issues, min_count=2))
print(validate_constraints(issues, keyword="bug"))

